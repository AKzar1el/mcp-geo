{
  "name": "@digestseo/mcp-geo",
  "version": "0.3.7",
  "description": "Self-hostable MCP server for AI visibility tracking across ChatGPT, Claude, Perplexity, Gemini, and Google AI Overviews. Free OSS with an optional EUR 99 one-time AI Visibility Audit for teams that want a client-ready baseline.",
  "private": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "mcpName": "io.github.AKzar1el/mcp-geo",
  "bin": {
    "digestseo-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AKzar1el/mcp-geo.git"
  },
  "homepage": "https://digestseo.com/geo-mcp/",
  "bugs": {
    "url": "https://github.com/AKzar1el/mcp-geo/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "seo",
    "geo",
    "generative-engine-optimization",
    "ai-visibility",
    "ai-search",
    "brand-monitoring",
    "cloudflare-workers",
    "claude"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc -p tsconfig.node.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test:unit": "node --import tsx --test \"tests/matching.test.ts\" \"tests/unit/*.test.ts\"",
    "test:stdio": "node --test tests/stdio-smoke.test.mjs",
    "test:smoke": "node --test tests/smoke.test.mjs",
    "mcpb:pack": "npm prune --omit=dev && npx @anthropic-ai/mcpb pack",
    "prepublishOnly": "npm run typecheck && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "body-parser": "2.3.0",
    "fast-uri": "3.1.7",
    "hono": "4.13.7",
    "ip-address": "10.7.2",
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@cloudflare/workers-oauth-provider": "^0.6.0",
    "@cloudflare/workers-types": "^4.20260520.1",
    "@types/node": "^25.9.3",
    "agents": "^0.13.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.93.0"
  }
}
