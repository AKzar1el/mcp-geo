    "test:smoke": "node --test tests/smoke.test.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.6.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260520.1",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.93.0"
  }
}
