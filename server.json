{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.AKzar1el/mcp-geo",
  "title": "GEO Tracker by DigestSEO",
  "description": "Track brand citations across seven AI search surfaces. Free OSS; optional EUR 99 client-ready audit.",
  "version": "0.3.18",
  "repository": {
    "url": "https://github.com/AKzar1el/mcp-geo",
    "source": "github"
  },
  "websiteUrl": "https://digestseo.com/geo-mcp/",
  "icons": [
    {
      "src": "https://digestseo.com/products/mcp-geo-mark.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@digestseo/mcp-geo",
      "version": "0.3.18",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "OPENAI_API_KEY",
          "description": "Optional OpenAI API key for ChatGPT visibility scans. Configure at least one provider key to run scans.",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "description": "Optional Anthropic API key for Claude scans, prompt generation, and content-gap analysis.",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "GEMINI_API_KEY",
          "description": "Optional Google AI Studio API key for Gemini visibility scans.",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "PERPLEXITY_API_KEY",
          "description": "Optional Perplexity API key for Perplexity visibility scans.",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "XAI_API_KEY",
          "description": "Optional xAI API key for grounded Grok visibility scans with web search.",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "SERPAPI_API_KEY",
          "description": "Optional SerpAPI key for Google AI Overviews visibility scans.",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "SERPAPI_AI_MODE_ENABLED",
          "description": "Optional non-secret flag. Set true to add Google AI Mode; this adds a separate SerpAPI request per prompt.",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        }
      ]
    }
  ],
  "tools": [
    {
      "name": "check_visibility",
      "description": "Get the latest AI visibility data for a tracked brand: which AI assistants (ChatGPT, Claude, Perplexity, Gemini, Grok, Google AI Overviews, Google AI Mode) cite this brand, for which prompts, and how it compares to competitors. Use when the user asks 'how visible am I on AI?', 'who's citing my brand?', or 'show me my AI visibility score'. Returns stored data — for fresh data, call refresh_brand.",
      "inputSchema": {
        "def": {
          "type": "object",
          "shape": {
            "brand_id": {
              "def": {
                "type": "string"
              },
              "type": "string",
              "format": null,
              "minLength": null,
              "maxLength": null
            },
            "engines": {
              "def": {
                "type": "optional",
                "innerType": {
                  "def": {
                    "type": "array",
                    "element": {
                      "def": {
                        "type": "enum",
                        "entries": {
                          "chatgpt": "chatgpt",
                          "claude": "claude",
                          "perplexity": "perplexity",
                          "gemini": "gemini",
                          "grok": "grok",
                          "ai_overviews": "ai_overviews",
                          "ai_mode": "ai_mode"
                        }
                      },
                      "type": "enum",
                      "enum": {
                        "chatgpt": "chatgpt",
                        "claude": "claude",
                        "perplexity": "perplexity",
                        "gemini": "gemini",
                        "grok": "grok",
                        "ai_overviews": "ai_overviews",
                        "ai_mode": "ai_mode"
                      },
                      "options": [
                        "chatgpt",
                        "claude",
                        "perplexity",
                        "gemini",
                        "grok",
                        "ai_overviews",
                        "ai_mode"
                      ]
                    }
                  },
                  "type": "array",
                  "element": {
                    "def": {
                      "type": "enum",
                      "entries": {
                        "chatgpt": "chatgpt",
                        "claude": "claude",
                        "perplexity": "perplexity",
                        "gemini": "gemini",
                        "grok": "grok",
                        "ai_overviews": "ai_overviews",
                        "ai_mode": "ai_mode"
                      }
                    },
                    "type": "enum",
                    "enum": {
                      "chatgpt": "chatgpt",
                      "claude": "claude",
                      "perplexity": "perplexity",
                      "gemini": "gemini",
                      "grok": "grok",
                      "ai_overviews": "ai_overviews",
                      "ai_mode": "ai_mode"
                    },
                    "options": [
                      "chatgpt",
                      "claude",
                      "perplexity",
                      "gemini",
                      "grok",
                      "ai_overviews",
                      "ai_mode"
                    ]
                  }
                }
              },
              "type": "optional"
            }
          }
        },
        "type": "object"
      }
    },
    {
      "name": "get_visibility_history",
      "description": "Get the time-series history of a brand's AI visibility score, broken down per engine. Use when the user asks 'how has my AI visibility changed over time?', 'is my visibility growing or shrinking?', or 'show me the trend for the last month'.",
      "inputSchema": {
        "def": {
          "type": "object",
          "shape": {
            "brand_id": {
              "def": {
                "type": "string"
              },
              "type": "string",
              "format": null,
              "minLength": null,
              "maxLength": null
            },
            "days": {
              "def": {
                "type": "default",
                "innerType": {
                  "def": {
                    "type": "number",
                    "checks": [
                      {},
                      {}
                    ]
                  },
                  "type": "number",
                  "minValue": 1,
                  "maxValue": 365,
                  "isInt": false,
                  "isFinite": true,
                  "format": null
                },
                "defaultValue": 30
              },
              "type": "default"
            },
            "granularity": {
              "def": {
                "type": "default",
                "innerType": {
                  "def": {
                    "type": "enum",
                    "entries": {
                      "daily": "daily",
                      "weekly": "weekly"
                    }
                  },
                  "type": "enum",
                  "enum": {
                    "daily": "daily",
                    "weekly": "weekly"
                  },
                  "options": [
                    "daily",
                    "weekly"
                  ]
                },
                "defaultValue": "weekly"
              },
              "type": "default"
            }
          }
        },
        "type": "object"
      }
    },
    {
      "name": "compare_competitors",
      "description": "Compare a brand's AI visibility against competitors for the same category. Returns share-of-voice percentages, prompts the user wins, and prompts where competitors win. Use when the user asks 'who beats me in AI search?', 'compare me to my competitors', or 'why does [competitor] get cited more?'.",
      "inputSchema": {
        "def": {
          "type": "object",
          "shape": {
            "brand_id": {
              "def": {
                "type": "string"
              },
              "type": "string",
              "format": null,
              "minLength": null,
              "maxLength": null
            },
            "competitor_domains": {
              "def": {
                "type": "optional",
                "innerType": {
                  "def": {
                    "type": "array",
                    "element": {
                      "def": {
                        "type": "string"
                      },
                      "type": "string",
                      "format": null,
                      "minLength": null,
                      "maxLength": null
                    }
                  },
                  "type": "array",
                  "element": {
                    "def": {
                      "type": "string"
                    },
                    "type": "string",
                    "format": null,
                    "minLength": null,
                    "maxLength": null
                  }
                }
              },
              "type": "optional"
            },
            "days": {
              "def": {
                "type": "default",
                "innerType": {
                  "def": {
                    "type": "number",
                    "checks": [
                      {},
                      {}
                    ]
                  },
                  "type": "number",
                  "minValue": 1,
                  "maxValue": 90,
                  "isInt": false,
                  "isFinite": true,
                  "format": null
                },
                "defaultValue": 7
              },
              "type": "default"
            }
          }
        },
        "type": "object"
      }
    },
    {
      "name": "get_citations",
      "description": "Get citation events where AI assistants mention the brand. Each event includes the prompt that triggered it, the LLM's response excerpt, whether the brand was mentioned with or without a link, and the matched brand URL from engine-native citation data when available. Use when the user asks 'show me where I'm cited', 'what are ChatGPT/Claude/Perplexity actually saying about my brand?', or 'give me proof of AI citations'.",
      "inputSchema": {
        "def": {
          "type": "object",
          "shape": {
            "brand_id": {
              "def": {
                "type": "string"
              },
              "type": "string",
              "format": null,
              "minLength": null,
              "maxLength": null
            },
            "days": {
              "def": {
                "type": "default",
                "innerType": {
                  "def": {
                    "type": "number",
                    "checks": [
                      {},
                      {}
                    ]
                  },
                  "type": "number",
                  "minValue": 1,
                  "maxValue": 90,
                  "isInt": false,
                  "isFinite": true,
                  "format": null
                },
                "defaultValue": 14
              },
              "type": "default"
            },
            "engine": {
              "def": {
                "type": "optional",
                "innerType": {
                  "def": {
                    "type": "enum",
                    "entries": {
                      "chatgpt": "chatgpt",
                      "claude": "claude",
                      "perplexity": "perplexity",
                      "gemini": "gemini",
                      "grok": "grok",
                      "ai_overviews": "ai_overviews",
                      "ai_mode": "ai_mode"
                    }
                  },
                  "type": "enum",
                  "enum": {
                    "chatgpt": "chatgpt",
                    "claude": "claude",
                    "perplexity": "perplexity",
                    "gemini": "gemini",
                    "grok": "grok",
                    "ai_overviews": "ai_overviews",
                    "ai_mode": "ai_mode"
                  },
                  "options": [
                    "chatgpt",
                    "claude",
                    "perplexity",
                    "gemini",
                    "grok",
                    "ai_overviews",
                    "ai_mode"
                  ]
                }
              },
              "type": "optional"
            }
          }
        },
        "type": "object"
      }
    },
    {
      "name": "get_content_gaps",
      "description": "Get actionable content recommendations based on AI visibility gaps. Returns prioritized topics and content formats that would close the gap between this brand and competitors winning the same prompts. Use when the user asks 'what should I write to improve AI visibility?', 'what content gaps do I have?', or 'how do I get cited more by AI?'.",
      "inputSchema": {
        "def": {
          "type": "object",
          "shape": {
            "brand_id": {
              "def": {
                "type": "string"
              },
              "type": "string",
              "format": null,
              "minLength": null,
              "maxLength": null
            },
            "max_recommendations": {
              "def": {
                "type": "default",
                "innerType": {
                  "def": {
                    "type": "number",
                    "checks": [
                      {},
                      {}
                    ]
                  },
                  "type": "number",
                  "minValue": 1,
                  "maxValue": 10,
                  "isInt": false,
                  "isFinite": true,
                  "format": null
                },
                "defaultValue": 5
              },
              "type": "default"
            }
          }
        },
        "type": "object"
      }
    },
    {
      "name": "refresh_brand",
      "description": "Manually trigger a fresh AI visibility scan for a tracked brand. The hosted Worker returns immediately with run IDs while selected engine scans finish asynchronously; the local CLI runs selected configured engines sequentially and returns only after they finish. Use when the user asks 'refresh my data', 'rerun the scan', or 'I want fresh data right now'.",
      "inputSchema": {
        "def": {
          "type": "object",
          "shape": {
            "brand_id": {
              "def": {
                "type": "string"
              },
              "type": "string",
              "format": null,
              "minLength": null,
              "maxLength": null
            },
            "engines": {
              "def": {
                "type": "optional",
                "innerType": {
                  "def": {
                    "type": "array",
                    "element": {
                      "def": {
                        "type": "enum",
                        "entries": {
                          "chatgpt": "chatgpt",
                          "claude": "claude",
                          "perplexity": "perplexity",
                          "gemini": "gemini",
                          "grok": "grok",
                          "ai_overviews": "ai_overviews",
                          "ai_mode": "ai_mode"
                        }
                      },
                      "type": "enum",
                      "enum": {
                        "chatgpt": "chatgpt",
                        "claude": "claude",
                        "perplexity": "perplexity",
                        "gemini": "gemini",
                        "grok": "grok",
                        "ai_overviews": "ai_overviews",
                        "ai_mode": "ai_mode"
                      },
                      "options": [
                        "chatgpt",
                        "claude",
                        "perplexity",
                        "gemini",
                        "grok",
                        "ai_overviews",
                        "ai_mode"
                      ]
                    }
                  },
                  "type": "array",
                  "element": {
                    "def": {
                      "type": "enum",
                      "entries": {
                        "chatgpt": "chatgpt",
                        "claude": "claude",
                        "perplexity": "perplexity",
                        "gemini": "gemini",
                        "grok": "grok",
                        "ai_overviews": "ai_overviews",
                        "ai_mode": "ai_mode"
                      }
                    },
                    "type": "enum",
                    "enum": {
                      "chatgpt": "chatgpt",
                      "claude": "claude",
                      "perplexity": "perplexity",
                      "gemini": "gemini",
                      "grok": "grok",
                      "ai_overviews": "ai_overviews",
                      "ai_mode": "ai_mode"
                    },
                    "options": [
                      "chatgpt",
                      "claude",
                      "perplexity",
                      "gemini",
                      "grok",
                      "ai_overviews",
                      "ai_mode"
                    ]
                  }
                }
              },
              "type": "optional"
            }
          }
        },
        "type": "object"
      }
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "license": "MIT",
      "notes": "Two deploy modes: run locally via `npx -y @digestseo/mcp-geo` (SQLite at ~/.digestseo, bring your own engine API keys), or self-host the Cloudflare Worker (D1 + cron auto-refresh; see SETUP.md or llms-install.md) and connect to your Worker URL at /mcp. Engines are opt-in: each supported engine activates only when its API key is set.",
      "tags": [
        "geo",
        "aeo",
        "ai-visibility",
        "generative-engine-optimization",
        "seo",
        "cloudflare-workers",
        "chatgpt",
        "claude",
        "perplexity",
        "gemini",
        "google-ai-overviews"
      ]
    }
  }
}
