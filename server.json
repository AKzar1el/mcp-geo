{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.AKzar1el/mcp-geo",
  "title": "GEO Tracker by DigestSEO",
  "description": "DigestSEO GEO Tracker: track brand citations across five AI search engines.",
  "version": "0.3.2",
  "repository": {
    "url": "https://github.com/AKzar1el/mcp-geo",
    "source": "github"
  },
  "websiteUrl": "https://digestseo.com/geo-mcp/",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://geo-mcp.digestseo.com/mcp"
    }
  ],
  "icons": [
    {
      "src": "https://digestseo.com/products/mcp-geo-mark.svg",
      "mimeType": "image/svg+xml",
      "sizes": ["any"]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@digestseo/mcp-geo",
      "version": "0.3.2",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "tools": [
    {
      "name": "check_visibility",
      "description": "Get the latest AI visibility data for a tracked brand: which AI assistants (ChatGPT, Claude, Perplexity, Gemini, Google AI Overviews) cite this brand, for which prompts, and how it compares to competitors. Use when the user asks 'how visible am I on AI?', 'who's citing my brand?', or 'show me my AI visibility score'. Returns stored data — for fresh data, call refresh_brand.",
      "inputSchema": {
        "def": {
          "type": "object",
          "shape": {
            "brand_id": {
              "def": {
                "type": "string"
              },
              "type": "string",
              "format": null,
              "minLength": null,
              "maxLength": null
            },
            "engines": {
              "def": {
                "type": "optional",
                "innerType": {
                  "def": {
                    "type": "array",
                    "element": {
                      "def": {
                        "type": "enum",
                        "entries": {
                          "chatgpt": "chatgpt",
                          "claude": "claude",
                          "perplexity": "perplexity",
                          "gemini": "gemini",
                          "ai_overviews": "ai_overviews"
                        }
                      },
                      "type": "enum",
                      "enum": {
                        "chatgpt": "chatgpt",
                        "claude": "claude",
                        "perplexity": "perplexity",
                        "gemini": "gemini",
                        "ai_overviews": "ai_overviews"
                      },
                      "options": [
                        "chatgpt",
                        "claude",
                        "perplexity",
                        "gemini",
                        "ai_overviews"
                      ]
                    }
                  },
                  "type": "array",
                  "element": {
                    "def": {
                      "type": "enum",
                      "entries": {
                        "chatgpt": "chatgpt",
                        "claude": "claude",
                        "perplexity": "perplexity",
                        "gemini": "gemini",
                        "ai_overviews": "ai_overviews"
                      }
                    },
                    "type": "enum",
                    "enum": {
                      "chatgpt": "chatgpt",
                      "claude": "claude",
                      "perplexity": "perplexity",
                      "gemini": "gemini",
                      "ai_overviews": "ai_overviews"
                    },
                    "options": [
                      "chatgpt",
                      "claude",
                      "perplexity",
                      "gemini",
                      "ai_overviews"
                    ]
                  }
                }
              },
              "type": "optional"
            }
          }
        },
        "type": "object"
      }
    },
    {
      "name": "get_visibility_history",
      "description": "Get the time-series history of a brand's AI visibility score, broken down per engine. Use when the user asks 'how has my AI visibility changed over time?', 'is my visibility growing or shrinking?', or 'show me the trend for the last month'.",
      "inputSchema": {
        "def": {
          "type": "object",
          "shape": {
            "brand_id": {
              "def": {
                "type": "string"
              },
              "type": "string",
              "format": null,
              "minLength": null,
              "maxLength": null
            },
            "days": {
              "def": {
                "type": "default",
                "innerType": {
                  "def": {
                    "type": "number",
                    "checks": [
                      {},
                      {}
                    ]
                  },
                  "type": "number",
                  "minValue": 1,
                  "maxValue": 365,
                  "isInt": false,
                  "isFinite": true,
                  "format": null
                },
                "defaultValue": 30
              },
              "type": "default"
            },
            "granularity": {
              "def": {
                "type": "default",
                "innerType": {
                  "def": {
                    "type": "enum",
                    "entries": {
                      "daily": "daily",
                      "weekly": "weekly"
                    }
                  },
                  "type": "enum",
                  "enum": {
                    "daily": "daily",
                    "weekly": "weekly"
                  },
                  "options": [
                    "daily",
                    "weekly"
                  ]
                },
                "defaultValue": "weekly"
              },
              "type": "default"
            }
          }
        },
        "type": "object"
      }
    },
    {
      "name": "compare_competitors",
      "description": "Compare a brand's AI visibility against competitors for the same category. Returns share-of-voice percentages, prompts the user wins, and prompts where competitors win. Use when the user asks 'who beats me in AI search?', 'compare me to my competitors', or 'why does [competitor] get cited more?'.",
      "inputSchema": {
        "def": {
          "type": "object",
          "shape": {
            "brand_id": {
              "def": {
                "type": "string"
              },
              "type": "string",
              "format": null,
              "minLength": null,
              "maxLength": null
            },
            "competitor_domains": {
              "def": {
                "type": "optional",
                "innerType": {
                  "def": {
                    "type": "array",
                    "element": {
                      "def": {
                        "type": "string"
                      },
                      "type": "string",
                      "format": null,
                      "minLength": null,
                      "maxLength": null
                    }
                  },
                  "type": "array",
                  "element": {
                    "def": {
                      "type": "string"
                    },
                    "type": "string",
                    "format": null,
                    "minLength": null,
                    "maxLength": null
                  }
                }
              },
              "type": "optional"
            },
            "days": {
              "def": {
                "type": "default",
                "innerType": {
                  "def": {
                    "type": "number",
                    "checks": [
                      {},
                      {}
                    ]
                  },
                  "type": "number",
                  "minValue": 1,
                  "maxValue": 90,
                  "isInt": false,
                  "isFinite": true,
                  "format": null
                },
                "defaultValue": 7
              },
              "type": "default"
            }
          }
        },
        "type": "object"
      }
    },
    {
      "name": "get_citations",
      "description": "Get citation events where AI assistants mention the brand. Each event includes the prompt that triggered it, the LLM's response excerpt, whether the brand was mentioned with or without a link, and the matched brand URL from engine-native citation data when available. Use when the user asks 'show me where I'm cited', 'what are ChatGPT/Claude/Perplexity actually saying about my brand?', or 'give me proof of AI citations'.",
      "inputSchema": {
        "def": {
          "type": "object",
          "shape": {
            "brand_id": {
              "def": {
                "type": "string"
              },
              "type": "string",
              "format": null,
              "minLength": null,
              "maxLength": null
            },
            "days": {
              "def": {
                "type": "default",
                "innerType": {
                  "def": {
                    "type": "number",
                    "checks": [
                      {},
                      {}
                    ]
                  },
                  "type": "number",
                  "minValue": 1,
                  "maxValue": 90,
                  "isInt": false,
                  "isFinite": true,
                  "format": null
                },
                "defaultValue": 14
              },
              "type": "default"
            },
            "engine": {
              "def": {
                "type": "optional",
                "innerType": {
                  "def": {
                    "type": "enum",
                    "entries": {
                      "chatgpt": "chatgpt",
                      "claude": "claude",
                      "perplexity": "perplexity",
                      "gemini": "gemini",
                      "ai_overviews": "ai_overviews"
                    }
                  },
                  "type": "enum",
                  "enum": {
                    "chatgpt": "chatgpt",
                    "claude": "claude",
                    "perplexity": "perplexity",
                    "gemini": "gemini",
                    "ai_overviews": "ai_overviews"
                  },
                  "options": [
                    "chatgpt",
                    "claude",
                    "perplexity",
                    "gemini",
                    "ai_overviews"
                  ]
                }
              },
              "type": "optional"
            }
          }
        },
        "type": "object"
      }
    },
    {
      "name": "get_content_gaps",
      "description": "Get actionable content recommendations based on AI visibility gaps. Returns prioritized topics and content formats that would close the gap between this brand and competitors winning the same prompts. Use when the user asks 'what should I write to improve AI visibility?', 'what content gaps do I have?', or 'how do I get cited more by AI?'.",
      "inputSchema": {
        "def": {
          "type": "object",
          "shape": {
            "brand_id": {
              "def": {
                "type": "string"
              },
              "type": "string",
              "format": null,
              "minLength": null,
              "maxLength": null
            },
            "max_recommendations": {
              "def": {
                "type": "default",
                "innerType": {
                  "def": {
                    "type": "number",
                    "checks": [
                      {},
                      {}
                    ]
                  },
                  "type": "number",
                  "minValue": 1,
                  "maxValue": 10,
                  "isInt": false,
                  "isFinite": true,
                  "format": null
                },
                "defaultValue": 5
              },
              "type": "default"
            }
          }
        },
        "type": "object"
      }
    },
    {
      "name": "refresh_brand",
      "description": "Manually trigger a fresh AI visibility scan for a tracked brand. The hosted Worker returns immediately with run IDs while selected engine scans finish asynchronously; the local CLI runs selected configured engines sequentially and returns only after they finish. Use when the user asks 'refresh my data', 'rerun the scan', or 'I want fresh data right now'.",
      "inputSchema": {
        "def": {
          "type": "object",
          "shape": {
            "brand_id": {
              "def": {
                "type": "string"
              },
              "type": "string",
              "format": null,
