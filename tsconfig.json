{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  // Node-only files (local stdio CLI + sqlite adapter) are typechecked
  // and built by tsconfig.node.json instead — they import node: builtins
  // that don't exist under @cloudflare/workers-types.
  "exclude": ["src/cli.ts", "src/db/sqlite.ts"]
}
