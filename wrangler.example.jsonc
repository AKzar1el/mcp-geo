// Cloudflare Worker configuration template for digestseo-mcp.
//
// Setup:
//   1. cp wrangler.example.jsonc wrangler.jsonc
//   2. Follow SETUP.md to create the KV namespaces + D1 database and
//      paste each returned id over the YOUR_*_ID placeholders below.
//
// wrangler.jsonc is gitignored — never commit it. This template is what
// stays in the repo.
{
	"name": "digestseo-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	// vars are plaintext, shipped with the worker. Don't put secrets
	// here — use `wrangler secret put` instead (see SETUP.md).
	"vars": {
		// Public URL of THIS deployed Worker. The /admin/run-live
		// orchestrator and the scheduled (cron) handler need to know
		// the worker's own canonical URL so they can build a Request
		// for env.SELF.fetch() (see "services" below). Update this
		// after your first `wrangler deploy` — wrangler will print the
		// URL it assigned, usually:
		//   https://digestseo-mcp.<your-subdomain>.workers.dev
		// The SELF service binding routes by pathname and ignores the
		// host, so runs work even with the placeholder in place — but
		// set the real URL anyway to keep logs honest and future-proof
		// any code that needs the worker's true origin.
		"SELF_URL": "https://YOUR-WORKER-NAME.YOUR-SUBDOMAIN.workers.dev"
	},
	// Service binding back to this same worker. /admin/run-live fans
	// out to /admin/run-engine once per engine via env.SELF.fetch() so
	// each engine gets its own worker invocation and its own free-plan
	// 50-subrequest budget. The host portion of the URL is irrelevant
	// to the binding (it routes by pathname), but a public-URL fetch
	// to your own workers.dev hostname would trip Cloudflare's
	// "Worker called itself" guard (error 1042) and never reach the
	// handler. The "service" name MUST match this file's "name" field.
	"services": [
		{ "binding": "SELF", "service": "digestseo-mcp" }
	],
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "YOUR_OAUTH_KV_ID"
		},
		{
			"binding": "RATE_LIMIT",
			"id": "YOUR_RATE_LIMIT_KV_ID"
		}
	],
	"d1_databases": [
		{
			"binding": "DIGESTSEO_DB",
			"database_name": "digestseo-db",
			"database_id": "YOUR_D1_DATABASE_ID"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "MCP_OBJECT",
				"class_name": "GeoMcpAgent"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"GeoMcpAgent"
			]
		}
	],
	// Auto-refresh trigger. Fires every 6h; the scheduled handler in
	// src/index.ts checks each brand's refresh_frequency (daily/weekly)
	// and only dispatches engines for brands that are actually due.
	"triggers": {
		"crons": [
			"0 */6 * * *"
		]
	}
	// Secrets are NOT stored here. They live in Cloudflare's encrypted
	// secret store, set via the CLI (or via the dashboard):
	//   npx wrangler secret put OPENAI_API_KEY
	// Expected secrets (all opt-in — set only the engines you want):
	//   - OPENAI_API_KEY      (ChatGPT engine)
	//   - ANTHROPIC_API_KEY   (Claude engine + prompt generation + content gaps)
	//   - GEMINI_API_KEY      (Gemini engine — free tier available)
	//   - PERPLEXITY_API_KEY  (Perplexity engine — paid)
	//   - SERPAPI_API_KEY     (Google AI Overviews engine — paid)
	//   - SEED_SECRET         (required — gates /admin/* routes)
	//   - CONNECT_SECRET      (recommended — gates the OAuth connect flow;
	//                          without it anyone with the URL can connect)
	//   - TURNSTILE_SITE_KEY  (optional — for forks adding a public /check route)
	//   - TURNSTILE_SECRET_KEY (optional — same)
}
