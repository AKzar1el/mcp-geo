# Files excluded from the .mcpb desktop-extension bundle (npm run mcpb:pack).
# The bundle needs: manifest.json, dist/, migrations/, assets/, and production
# node_modules only. The pack script prunes dev dependencies first so transitive
# build tooling cannot leak into the desktop-extension archive.

# Sources and tests (the bundle runs the compiled dist/)
src/
tests/
docs/
*.ts

# Worker-only / repo files
wrangler.example.jsonc
wrangler.jsonc
worker-configuration.d.ts
.dev.vars
.dev.vars.example
server.json
glama.json
Dockerfile
.dockerignore
llms-install.md
SETUP.md
CHANGELOG.md
CONTRIBUTING.md
tsconfig.json
tsconfig.node.json
.github/
.wrangler/
.claude/
*.tgz
*.mcpb

# Belt-and-suspenders exclusions for dev-only dependency trees. The pack script
# already runs `npm prune --omit=dev` before archiving.
node_modules/wrangler/
node_modules/workerd/
node_modules/miniflare/
node_modules/typescript/
node_modules/tsx/
node_modules/agents/
node_modules/esbuild/
node_modules/@esbuild/
node_modules/@cloudflare/
node_modules/@types/
node_modules/@typescript/
