{
  // Node build for the local stdio CLI (npm package). Compiles the
  // runtime-agnostic core, the sqlite Db adapter, and the CLI entry to
  // dist/. The Worker entry (src/index.ts, src/engines.ts,
  // src/db/d1.ts) is deliberately excluded — it imports Workers types
  // and is bundled by wrangler, not tsc.
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "declaration": false
  },
  "include": [
    "src/cli.ts",
    "src/core/**/*.ts",
    "src/db/types.ts",
    "src/db/sqlite.ts"
  ],
  "exclude": ["src/index.ts", "src/engines.ts", "src/db/d1.ts"]
}
