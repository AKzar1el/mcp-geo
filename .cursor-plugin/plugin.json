{
  "name": "digestseo-geo",
  "displayName": "GEO Tracker by DigestSEO",
  "version": "0.3.13",
  "description": "Track brand citations and AI visibility across ChatGPT, Claude, Perplexity, Gemini, and Google AI Overviews. Free OSS with an optional EUR 99 one-time AI Visibility Audit.",
  "author": {
    "name": "DigestSEO"
  },
  "publisher": "DigestSEO",
  "homepage": "https://digestseo.com/geo-mcp/",
  "repository": "https://github.com/AKzar1el/mcp-geo",
  "license": "MIT",
  "logo": "icon.png",
  "keywords": [
    "mcp",
    "seo",
    "geo",
    "ai-visibility",
    "brand-monitoring"
  ],
  "category": "data-and-apis",
  "tags": [
    "mcp",
    "seo",
    "generative-engine-optimization",
    "ai-search"
  ],
  "variables": {
    "type": "object",
    "properties": {
      "OPENAI_API_KEY": {
        "type": "string",
        "title": "OpenAI API key",
        "description": "Optional. Enables ChatGPT visibility scans."
      },
      "ANTHROPIC_API_KEY": {
        "type": "string",
        "title": "Anthropic API key",
        "description": "Optional. Enables Claude visibility scans."
      },
      "GEMINI_API_KEY": {
        "type": "string",
        "title": "Gemini API key",
        "description": "Optional. Enables Gemini visibility scans."
      },
      "PERPLEXITY_API_KEY": {
        "type": "string",
        "title": "Perplexity API key",
        "description": "Optional. Enables Perplexity visibility scans."
      },
      "SERPAPI_API_KEY": {
        "type": "string",
        "title": "SerpAPI key",
        "description": "Optional. Enables Google AI Overviews scans."
      }
    }
  },
  "mcpServers": {
    "digestseo-geo": {
      "command": "npx",
      "args": ["-y", "@digestseo/mcp-geo"],
      "env": {
        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}",
        "GEMINI_API_KEY": "${GEMINI_API_KEY}",
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}",
        "SERPAPI_API_KEY": "${SERPAPI_API_KEY}"
      }
    }
  }
}
