{
  "manifest_version": "0.2",
  "name": "digestseo-mcp",
  "display_name": "GEO Tracker by DigestSEO",
  "version": "0.3.2",
  "description": "DigestSEO mcp-geo: track brand citations across five AI search engines.",
  "long_description": "Self-hosted AI visibility tracking over MCP. Runs buyer-intent prompts against the AI engines you hold API keys for, records which ones cite your brand versus competitors, and exposes nine tools: track_brand, list_brands, generate_prompts, refresh_brand, check_visibility, get_visibility_history, compare_competitors, get_citations, get_content_gaps. All data stays in a local SQLite database under ~/.digestseo.",
  "author": {
    "name": "AKzar1el",
    "url": "https://github.com/AKzar1el"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AKzar1el/mcp-geo"
  },
  "homepage": "https://digestseo.com/geo-mcp/",
  "license": "MIT",
  "icon": "icon.jpg",
  "privacy_policies": [
    "https://github.com/AKzar1el/mcp-geo#privacy-policy",
    "https://openai.com/policies/privacy-policy",
    "https://www.anthropic.com/legal/privacy",
    "https://policies.google.com/privacy",
    "https://www.perplexity.ai/hub/legal/privacy-policy",
    "https://serpapi.com/legal"
  ],
  "server": {
    "type": "node",
    "entry_point": "dist/cli.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/dist/cli.js"
      ],
      "env": {
        "OPENAI_API_KEY": "${user_config.openai_api_key}",
        "ANTHROPIC_API_KEY": "${user_config.anthropic_api_key}",
        "GEMINI_API_KEY": "${user_config.gemini_api_key}",
        "PERPLEXITY_API_KEY": "${user_config.perplexity_api_key}",
        "SERPAPI_API_KEY": "${user_config.serpapi_api_key}"
      }
    }
  },
  "user_config": {
    "openai_api_key": {
      "type": "string",
      "title": "OpenAI API Key (ChatGPT engine)",
      "description": "Optional — every engine key is opt-in, but at least one of the five is required for the server to do anything useful. Engines without a key are skipped gracefully.",
      "sensitive": true,
      "required": false
    },
    "anthropic_api_key": {
      "type": "string",
      "title": "Anthropic API Key (Claude engine)",
      "description": "Optional — also powers prompt generation and content-gap analysis via Claude Haiku. At least one of the five engine keys is required.",
      "sensitive": true,
      "required": false
    },
    "gemini_api_key": {
      "type": "string",
      "title": "Google AI Studio API Key (Gemini engine)",
      "description": "Optional — free tier available at aistudio.google.com. At least one of the five engine keys is required.",
      "sensitive": true,
      "required": false
    },
    "perplexity_api_key": {
      "type": "string",
      "title": "Perplexity API Key (Perplexity engine)",
      "description": "Optional — paid plans only. At least one of the five engine keys is required.",
      "sensitive": true,
      "required": false
    },
    "serpapi_api_key": {
      "type": "string",
      "title": "SerpAPI Key (Google AI Overviews engine)",
      "description": "Optional — free tier covers 250 searches/month. At least one of the five engine keys is required.",
      "sensitive": true,
      "required": false
    }
  },
  "tools": [
    {
      "name": "check_visibility",
      "description": "Get the latest AI visibility data for a tracked brand: which AI assistants (ChatGPT, Claude, Perplexity, Gemini, Google AI Overviews) cite this brand, for which prompts, and how it compares to competitors. Use when the user asks 'how visible am I on AI?', 'who's citing my brand?', or 'show me my AI visibility score'. Returns stored data — for fresh data, call refresh_brand.",
      "inputSchema": {
        "def": {
          "type": "object",
          "shape": {
            "brand_id": {
              "def": {
                "type": "string"
              },
              "type": "string",
              "format": null,
              "minLength": null,
              "maxLength": null
            },
            "engines": {
              "def": {
                "type": "optional",
                "innerType": {
                  "def": {
                    "type": "array",
                    "element": {
                      "def": {
                        "type": "enum",
                        "entries": {
                          "chatgpt": "chatgpt",
                          "claude": "claude",
                          "perplexity": "perplexity",
                          "gemini": "gemini",
                          "ai_overviews": "ai_overviews"
                        }
                      },
                      "type": "enum",
                      "enum": {
                        "chatgpt": "chatgpt",
                        "claude": "claude",
                        "perplexity": "perplexity",
                        "gemini": "gemini",
                        "ai_overviews": "ai_overviews"
                      },
                      "options": [
                        "chatgpt",
                        "claude",
                        "perplexity",
                        "gemini",
                        "ai_overviews"
                      ]
                    }
                  },
                  "type": "array",
                  "element": {
                    "def": {
                      "type": "enum",
                      "entries": {
                        "chatgpt": "chatgpt",
                        "claude": "claude",
                        "perplexity": "perplexity",
                        "gemini": "gemini",
                        "ai_overviews": "ai_overviews"
                      }
                    },
                    "type": "enum",
                    "enum": {
                      "chatgpt": "chatgpt",
                      "claude": "claude",
                      "perplexity": "perplexity",
                      "gemini": "gemini",
                      "ai_overviews": "ai_overviews"
                    },
                    "options": [
                      "chatgpt",
                      "claude",
                      "perplexity",
                      "gemini",
                      "ai_overviews"
                    ]
                  }
                }
              },
              "type": "optional"
            }
          }
        },
        "type": "object"
      }
    },
    {
      "name": "get_visibility_history",
      "description": "Get the time-series history of a brand's AI visibility score, broken down per engine. Use when the user asks 'how has my AI visibility changed over time?', 'is my visibility growing or shrinking?', or 'show me the trend for the last month'.",
      "inputSchema": {
        "def": {
          "type": "object",
          "shape": {
            "brand_id": {
              "def": {
                "type": "string"
              },
              "type": "string",
              "format": null,
              "minLength": null,
              "maxLength": null
            },
            "days": {
              "def": {
                "type": "default",
                "innerType": {
                  "def": {
                    "type": "number",
                    "checks": [
                      {},
                      {}
                    ]
                  },
                  "type": "number",
                  "minValue": 1,
                  "maxValue": 365,
                  "isInt": false,
                  "isFinite": true,
                  "format": null
                },
                "defaultValue": 30
              },
              "type": "default"
            },
            "granularity": {
              "def": {
                "type": "default",
                "innerType": {
                  "def": {
                    "type": "enum",
                    "entries": {
                      "daily": "daily",
                      "weekly": "weekly"
                    }
                  },
                  "type": "enum",
                  "enum": {
                    "daily": "daily",
                    "weekly": "weekly"
                  },
                  "options": [
                    "daily",
                    "weekly"
                  ]
                },
                "defaultValue": "weekly"
              },
              "type": "default"
            }
          }
        },
        "type": "object"
      }
    },
    {
      "name": "compare_competitors",
      "description": "Compare a brand's AI visibility against competitors for the same category. Returns share-of-voice percentages, prompts the user wins, and prompts where competitors win. Use when the user asks 'who beats me in AI search?', 'compare me to my competitors', or 'why does [competitor] get cited more?'.",
      "inputSchema": {
        "def": {
          "type": "object",
          "shape": {
            "brand_id": {
              "def": {
                "type": "string"
              },
              "type": "string",
              "format": null,
              "minLength": null,
              "maxLength": null
            },
            "competitor_domains": {
              "def": {
                "type": "optional",
                "innerType": {
                  "def": {
                    "type": "array",
                    "element": {
                      "def": {
                        "type": "string"
                      },
                      "type": "string",
                      "format": null,
                      "minLength": null,
                      "maxLength": null
                    }
                  },
                  "type": "array",
                  "element": {
                    "def": {
                      "type": "string"
                    },
                    "type": "string",
                    "format": null,
                    "minLength": null,
                    "maxLength": null
                  }
                }
              },
              "type": "optional"
            },
            "days": {
              "def": {
                "type": "default",
                "innerType": {
                  "def": {
                    "type": "number",
                    "checks": [
                      {},
                      {}
                    ]
                  },
                  "type": "number",
                  "minValue": 1,
                  "maxValue": 90,
                  "isInt": false,
                  "isFinite": true,
                  "format": null
                },
                "defaultValue": 7
              },
              "type": "default"
            }
          }
        },
        "type": "object"
      }
    },
    {
      "name": "get_citations",
      "description": "Get citation events where AI assistants mention the brand. Each event includes the prompt that triggered it, the LLM's response excerpt, whether the brand was mentioned with or without a link, and the matched brand URL from engine-native citation data when available. Use when the user asks 'show me where I'm cited', 'what are ChatGPT/Claude/Perplexity actually saying about my brand?', or 'give me proof of AI citations'.",
      "inputSchema": {
        "def": {
          "type": "object",
          "shape": {
            "brand_id": {
              "def": {
                "type": "string"
              },
              "type": "string",
              "format": null,
              "minLength": null,
              "maxLength": null
            },
            "days": {
              "def": {
                "type": "default",
                "innerType": {
                  "def": {
                    "type": "number",
                    "checks": [
                      {},
                      {}
                    ]
                  },
                  "type": "number",
                  "minValue": 1,
                  "maxValue": 90,
                  "isInt": false,
                  "isFinite": true,
                  "format": null
                },
                "defaultValue": 14
              },
              "type": "default"
            },
            "engine": {
              "def": {
                "type": "optional",
                "innerType": {
                  "def": {
                    "type": "enum",
                    "entries": {
                      "chatgpt": "chatgpt",
                      "claude": "claude",
                      "perplexity": "perplexity",
                      "gemini": "gemini",
                      "ai_overviews": "ai_overviews"
                    }
                  },
                  "type": "enum",
                  "enum": {
                    "chatgpt": "chatgpt",
                    "claude": "claude",
                    "perplexity": "perplexity",
                    "gemini": "gemini",
                    "ai_overviews": "ai_overviews"
                  },
                  "options": [
                    "chatgpt",
                    "claude",
                    "perplexity",
                    "gemini",
                    "ai_overviews"
                  ]
                }
              },
              "type": "optional"
            }
          }
        },
        "type": "object"
      }
    },
    {
      "name": "get_content_gaps",
      "description": "Get actionable content recommendations based on AI visibility gaps. Returns prioritized topics and content formats that would close the gap between this brand and competitors winning the same prompts. Use when the user asks 'what should I write to improve AI visibility?', 'what content gaps do I have?', or 'how do I get cited more by AI?'.",
      "inputSchema": {
        "def": {
          "type": "object",
          "shape": {
            "brand_id": {
              "def": {
                "type": "string"
              },
              "type": "string",
              "format": null,
              "minLength": null,
              "maxLength": null
            },
            "max_recommendations": {
              "def": {
                "type": "default",
                "innerType": {
                  "def": {
                    "type": "number",
                    "checks": [
                      {},
                      {}
                    ]
                  },
                  "type": "number",
                  "minValue": 1,
                  "maxValue": 10,
                  "isInt": false,
                  "isFinite": true,
                  "format": null
                },
                "defaultValue": 5
              },
              "type": "default"
            }
          }
        },
        "type": "object"
      }
    },
    {
      "name": "refresh_brand",
      "description": "Manually trigger a fresh AI visibility scan for a tracked brand. Runs every selected configured engine (ChatGPT, Claude, Perplexity, Gemini, Google AI Overviews) against the brand's current prompt set sequentially. Use when the user asks 'refresh my data', 'rerun the scan', or 'I want fresh data right now'. Returns only after all selected engine scans finish.",
      "inputSchema": {
        "def": {
          "type": "object",
          "shape": {
            "brand_id": {
              "def": {
                "type": "string"
              },
              "type": "string",
              "format": null,
              "minLength": null,
              "maxLength": null
            },
            "engines": {
              "def": {
                "type": "optional",
                "innerType": {
                  "def": {
                    "type": "array",
                    "element": {
                      "def": {
                        "type": "enum",
                        "entries": {
                          "chatgpt": "chatgpt",
                          "claude": "claude",
                          "perplexity": "perplexity",
                          "gemini": "gemini",
                          "ai_overviews": "ai_overviews"
                        }
                      },
                      "type": "enum",
                      "enum": {
                        "chatgpt": "chatgpt",
                        "claude": "claude",
                        "perplexity": "perplexity",
                        "gemini": "gemini",
                        "ai_overviews": "ai_overviews"
                      },
                      "options": [
                        "chatgpt",
                        "claude",
                        "perplexity",
                        "gemini",
                        "ai_overviews"
                      ]
                    }
                  },
                  "type": "array",
                  "element": {
                    "def": {
                      "type": "enum",
                      "entries": {
                        "chatgpt": "chatgpt",
                        "claude": "claude",
                        "perplexity": "perplexity",
                        "gemini": "gemini",
                        "ai_overviews": "ai_overviews"
                      }
                    },
                    "type": "enum",
                    "enum": {
                      "chatgpt": "chatgpt",
                      "claude": "claude",
                      "perplexity": "perplexity",
                      "gemini": "gemini",
                      "ai_overviews": "ai_overviews"
                    },
                    "options": [
                      "chatgpt",
                      "claude",
                      "perplexity",
                      "gemini",
                      "ai_overviews"
                    ]
                  }
                }
              },
              "type": "optional"
            }
          }
        },
        "type": "object"
      }
    }
  ],
  "keywords": [
    "seo",
    "geo",
    "ai-visibility",
    "brand-monitoring",
    "generative-engine-optimization"
  ],
  "compatibility": {
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ],
    "runtimes": {
      "node": ">=18.0.0"
    }
  }
}
